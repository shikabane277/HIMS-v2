APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────
# "Forgot password?" sends a real email, so a real transport is required.
#
# Set MAIL_MAILER to gmail, outlook, yahoo, or brevo. Host, port and encryption are
# preconfigured for each in config/mail.php, so these are the only values you
# need to supply:
#
#     MAIL_MAILER      gmail | outlook | yahoo | brevo
#     MAIL_USERNAME    your full email address
#     MAIL_PASSWORD    an APP PASSWORD, not your account password
#
# App password setup:
#   Gmail    https://myaccount.google.com/apppasswords   (needs 2FA enabled)
#   Outlook  account.microsoft.com/security → App passwords
#            (work/school tenants: MAIL_OUTLOOK_HOST=smtp.office365.com)
#   Yahoo    login.yahoo.com/account/security → Generate app password
#
# MAIL_FROM_ADDRESS must be the same mailbox as MAIL_USERNAME — these providers
# refuse to send as an address you did not authenticate as.
#
# ── Railway / PaaS deployments ──
# Railway blocks outbound SMTP on Free/Trial/Hobby plans, so gmail/outlook/yahoo
# presets cannot work there. Use MAIL_MAILER=brevo instead — it sends over
# HTTPS (port 443), which is open on every plan.
#
# MAIL_MAILER=log delivers nothing — local development only.
# After any change: php artisan config:clear
# Verify with:      php artisan hims:mail-test you@example.com
MAIL_MAILER=log
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# MAIL_OUTLOOK_HOST=smtp.office365.com

# ── Brevo / Sendinblue (HTTPS API transport — works on Railway, Render, etc.) ───
# Sign up at https://brevo.com, create an API key, then set:
#
#     MAIL_MAILER=brevo
#     BREVO_API_KEY=xkeysib-xxxxxxxxx
#     MAIL_FROM_ADDRESS=your-verified-email@example.com
#
# Single Sender Verification: Brevo allows you to verify a single personal or
# work email address in their dashboard (https://app.brevo.com/senders) without
# needing a custom domain or DNS records.
#
# After any change: php artisan config:clear
# Verify with:      php artisan hims:mail-test you@example.com
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── AI providers ────────────────────────────────────────────────────────────
# Pick the active provider. Options: gemini | openai | anthropic | compatible
# Gemini is the default; a provider only activates once its API key is set.
AI_PROVIDER=gemini
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=1024
# AI_TIMEOUT=30

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (GPT) — Chat Completions
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — Messages API
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI-compatible host (Groq / DeepSeek / xAI / Mistral / Together / OpenRouter / Ollama)
# AI_COMPATIBLE_LABEL=Groq
# AI_COMPATIBLE_API_KEY=
# AI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
# AI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
